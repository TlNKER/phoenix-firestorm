<llsd>
  <array>

    <!-- Lean skin-picker list for the Horizon install. Only lists skins
         that actually ship in C:\Horizon (default is always available and
         is not listed here, same as the main skins.xml). Deliberately does
         NOT include AnsaStorm/Firestorm/MetaHarper/StarLight/StarLight CUI
         like the main skins.xml does - those skin folders are not copied
         into this install, and a picker entry pointing at a missing folder
         is worse than just not listing it. -->

    <map>
      <key>name</key>
      <string>Tinkered</string>
      <key>folder</key>
      <string>tinkered</string>
      <key>themes</key>
      <array>
        <map>
          <key>name</key>
          <string>Classic</string>
          <key>folder</key>
          <string/>
        </map>
      </array>
    </map>

    <map>
      <key>name</key>
      <string>Blue Horizon</string>
      <key>folder</key>
      <string>blue_horizon</string>
      <key>themes</key>
      <array>
        <map>
          <key>name</key>
          <string>Classic</string>
          <key>folder</key>
          <string/>
        </map>
      </array>
    </map>

  </array>
</llsd>
